{
  "functions": {
    "api/company.js": {
      "maxDuration": 300
    },
    "api/market.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/schwab/:action",
      "destination": "/api/schwab?action=:action"
    },
    {
      "source": "/api/filings",
      "destination": "/api/company?resource=filings"
    },
    {
      "source": "/api/statements",
      "destination": "/api/company?resource=statements"
    },
    {
      "source": "/api/narrative",
      "destination": "/api/company?resource=narrative"
    },
    {
      "source": "/api/news",
      "destination": "/api/company?resource=news"
    },
    {
      "source": "/api/sections",
      "destination": "/api/company?resource=sections"
    },
    {
      "source": "/api/screener",
      "destination": "/api/company?resource=screener"
    },
    {
      "source": "/api/valuations",
      "destination": "/api/saved?resource=valuations"
    },
    {
      "source": "/api/reverse",
      "destination": "/api/saved?resource=reverse"
    },
    {
      "source": "/api/portfolio",
      "destination": "/api/saved?resource=portfolio"
    },
    {
      "source": "/api/prices",
      "destination": "/api/market?resource=prices"
    },
    {
      "source": "/api/ticker",
      "destination": "/api/market?resource=ticker"
    },
    {
      "source": "/api/watchlist",
      "destination": "/api/market?resource=watchlist"
    },
    {
      "source": "/api/treasury",
      "destination": "/api/market?resource=treasury"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
